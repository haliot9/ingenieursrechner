{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "theme"],
  "additionalProperties": false,
  "properties": { "version": { "type": "integer", "const": 1 }, "theme": { "$ref": "#/$defs/theme" } },
  "$defs": {
    "decimal": { "type": "number", "multipleOf": 0.01 },
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "theme": { "type": "object", "additionalProperties": false, "required": ["tailOpacityAtTip", "dark", "light"], "properties": { "tailOpacityAtTip": { "$ref": "#/$defs/decimal", "minimum": 0.1, "maximum": 1 }, "dark": { "$ref": "#/$defs/dark" }, "light": { "$ref": "#/$defs/light" } } },
    "dark": { "type": "object", "additionalProperties": false, "required": ["body", "linePrimary", "lineSecondary", "lineAccent", "baseOpacity", "lineGlow", "tipGlow"], "properties": { "body": { "$ref": "#/$defs/darkBody" }, "linePrimary": { "$ref": "#/$defs/hex" }, "lineSecondary": { "$ref": "#/$defs/hex" }, "lineAccent": { "$ref": "#/$defs/hex" }, "baseOpacity": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "lineGlow": { "$ref": "#/$defs/lineGlow" }, "tipGlow": { "$ref": "#/$defs/tipGlow" } } },
    "darkBody": { "type": "object", "additionalProperties": false, "required": ["startColor", "middleColor", "endColor", "coreOpacity", "emissionOpacity", "emissionRadiusPx", "freshTrailLengthPx"], "properties": { "startColor": { "$ref": "#/$defs/hex" }, "middleColor": { "$ref": "#/$defs/hex" }, "endColor": { "$ref": "#/$defs/hex" }, "coreOpacity": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "emissionOpacity": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "emissionRadiusPx": { "$ref": "#/$defs/decimal", "minimum": 0.5, "maximum": 32 }, "freshTrailLengthPx": { "$ref": "#/$defs/decimal", "minimum": 8, "maximum": 200 } } },
    "lineGlow": { "type": "object", "additionalProperties": false, "required": ["radiusPx", "opacity"], "properties": { "radiusPx": { "$ref": "#/$defs/decimal", "minimum": 0.5, "maximum": 32 }, "opacity": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 0.5 } } },
    "tipGlow": { "type": "object", "additionalProperties": false, "required": ["diameterToLineWidth", "tailLengthToDiameter", "haloDiameterToHead", "opacity", "freshTrailLengthPx", "pinkMix", "cyanMix", "pulseHz", "pulseDepth", "secondaryPulseRatio"], "properties": { "diameterToLineWidth": { "$ref": "#/$defs/decimal", "minimum": 1, "maximum": 3 }, "tailLengthToDiameter": { "$ref": "#/$defs/decimal", "minimum": 1.25, "maximum": 8 }, "haloDiameterToHead": { "$ref": "#/$defs/decimal", "minimum": 1, "maximum": 6 }, "opacity": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "freshTrailLengthPx": { "$ref": "#/$defs/decimal", "minimum": 8, "maximum": 200 }, "pinkMix": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "cyanMix": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "pulseHz": { "$ref": "#/$defs/decimal", "minimum": 0.05, "maximum": 3 }, "pulseDepth": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "secondaryPulseRatio": { "$ref": "#/$defs/decimal", "minimum": 1.01, "maximum": 3 } } },
    "light": { "type": "object", "additionalProperties": false, "required": ["body", "linePrimary", "lineSecondary", "paperFiber", "baseOpacity", "tipInk"], "properties": { "body": { "$ref": "#/$defs/lightBody" }, "linePrimary": { "$ref": "#/$defs/hex" }, "lineSecondary": { "$ref": "#/$defs/hex" }, "paperFiber": { "$ref": "#/$defs/hex" }, "baseOpacity": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "tipInk": { "$ref": "#/$defs/tipInk" } } },
    "lightBody": { "type": "object", "additionalProperties": false, "required": ["wetBlueBlack", "settledBlue", "agedSepia", "fadedWarmSepia", "coreOpacity", "freshTrailLengthPx", "fiberScalePx", "fiberStrength", "sheenOpacity", "absorptionRadiusPx", "absorptionOpacity"], "properties": { "wetBlueBlack": { "$ref": "#/$defs/hex" }, "settledBlue": { "$ref": "#/$defs/hex" }, "agedSepia": { "$ref": "#/$defs/hex" }, "fadedWarmSepia": { "$ref": "#/$defs/hex" }, "coreOpacity": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "freshTrailLengthPx": { "$ref": "#/$defs/decimal", "minimum": 8, "maximum": 200 }, "fiberScalePx": { "$ref": "#/$defs/decimal", "minimum": 1, "maximum": 32 }, "fiberStrength": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "sheenOpacity": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 0.5 }, "absorptionRadiusPx": { "$ref": "#/$defs/decimal", "minimum": 0.5, "maximum": 32 }, "absorptionOpacity": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 0.5 } } },
    "tipInk": { "type": "object", "additionalProperties": false, "required": ["wetColor", "diameterToLineWidth", "tailLengthToDiameter", "bleedDiameterToHead", "lineBleedRadiusPx", "freshTrailLengthPx", "irregularity", "absorptionOpacity", "specularOpacity"], "properties": { "wetColor": { "$ref": "#/$defs/hex" }, "diameterToLineWidth": { "$ref": "#/$defs/decimal", "minimum": 1, "maximum": 3 }, "tailLengthToDiameter": { "$ref": "#/$defs/decimal", "minimum": 1.25, "maximum": 8 }, "bleedDiameterToHead": { "$ref": "#/$defs/decimal", "minimum": 1, "maximum": 4 }, "lineBleedRadiusPx": { "$ref": "#/$defs/decimal", "minimum": 0.5, "maximum": 32 }, "freshTrailLengthPx": { "$ref": "#/$defs/decimal", "minimum": 8, "maximum": 200 }, "irregularity": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "absorptionOpacity": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "specularOpacity": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 } } }
  }
}
