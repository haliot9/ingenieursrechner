{
  "name": "ingenieursrechner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run line-field:config && npm run landing-background:config && npm run elastic-menu-chain:config",
    "build": "tsc -b && vite build && npm run check:bundle",
    "prebuild": "npm run line-field:config:check && npm run landing-background:config:check && npm run elastic-menu-chain:config:check",
    "check:bundle": "node scripts/check-initial-bundle.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:process-gates",
    "test:unit": "vitest run --project unit",
    "test:process-gates": "vitest run --project process-gates",
    "pretest": "npm run line-field:config:check && npm run landing-background:config:check && npm run elastic-menu-chain:config:check",
    "test:e2e": "npm run test:e2e:full",
    "test:e2e:release": "npm run build && playwright test e2e/routing-calculator.spec.ts e2e/theme-control-materials.spec.ts e2e/line-field-renderer.spec.ts e2e/performance.spec.ts",
    "test:e2e:full": "npm run build && playwright test",
    "test:watch": "vitest --project unit",
    "verify": "npm test && npm run lint && npm run build && npm run audit:production",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:development": "npm audit --audit-level=high",
    "line-field:config": "node scripts/compile-line-field-config.mjs --write",
    "line-field:config:check": "node scripts/compile-line-field-config.mjs --check",
    "line-field:config:watch": "node scripts/compile-line-field-config.mjs --watch",
    "landing-background:config": "node scripts/compile-landing-background-config.mjs --write",
    "landing-background:config:check": "node scripts/compile-landing-background-config.mjs --check",
    "landing-background:config:watch": "node scripts/compile-landing-background-config.mjs --watch",
    "elastic-menu-chain:config": "node scripts/compile-elastic-menu-chain-config.mjs --write",
    "elastic-menu-chain:config:check": "node scripts/compile-elastic-menu-chain-config.mjs --check",
    "elastic-menu-chain:config:watch": "node scripts/compile-elastic-menu-chain-config.mjs --watch",
    "session3:evidence": "node scripts/run-session3-evidence.mjs"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "katex": "^0.16.28",
    "mathjs": "^15.1.1",
    "ogl": "1.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "ajv": "8.20.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fast-check": "^4.5.3",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "yaml": "2.9.0"
  },
  "license": "MIT"
}
