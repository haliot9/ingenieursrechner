{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "geometry", "wave", "reveal", "fronts", "handoff", "pointer", "motto", "performance"],
  "additionalProperties": false,
  "properties": { "version": { "type": "integer", "const": 1 }, "geometry": { "$ref": "#/$defs/geometry" }, "wave": { "$ref": "#/$defs/wave" }, "reveal": { "$ref": "#/$defs/reveal" }, "fronts": { "$ref": "#/$defs/fronts" }, "handoff": { "$ref": "#/$defs/handoff" }, "pointer": { "$ref": "#/$defs/pointer" }, "motto": { "$ref": "#/$defs/motto" }, "performance": { "$ref": "#/$defs/performance" } },
  "$defs": {
    "decimal": { "type": "number", "multipleOf": 0.01 }, "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "geometry": { "type": "object", "additionalProperties": false, "required": ["staggeredTipCount", "spineWidthPx", "lineWidthPx", "headerGapPx"], "properties": { "staggeredTipCount": { "type": "integer", "minimum": 5, "maximum": 40 }, "spineWidthPx": { "$ref": "#/$defs/decimal", "minimum": 0.5, "maximum": 6 }, "lineWidthPx": { "$ref": "#/$defs/decimal", "minimum": 0.25, "maximum": 3 }, "headerGapPx": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 64 } } },
    "wave": { "type": "object", "additionalProperties": false, "required": ["scrollPhaseCycles", "autonomousCyclesPerSecond"], "properties": { "scrollPhaseCycles": { "$ref": "#/$defs/decimal", "minimum": 0.1, "maximum": 8 }, "autonomousCyclesPerSecond": { "$ref": "#/$defs/decimal", "minimum": 0.05, "maximum": 3 } } },
    "reveal": { "type": "object", "additionalProperties": false, "required": ["preloadFilmProgress", "startFilmProgress"], "properties": { "preloadFilmProgress": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "startFilmProgress": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 } } },
    "fronts": { "type": "object", "additionalProperties": false, "required": ["seed", "maximumTipGapVh", "staggerStrength", "catchupRatePerSecond", "autonomousVelocityViewportPerSecond", "autonomousAccelerationViewportPerSecondSquared"], "properties": { "seed": { "type": "integer", "minimum": 0, "maximum": 2147483647 }, "maximumTipGapVh": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 10 }, "staggerStrength": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "catchupRatePerSecond": { "$ref": "#/$defs/decimal", "minimum": 0.1, "maximum": 30 }, "autonomousVelocityViewportPerSecond": { "$ref": "#/$defs/decimal", "minimum": 0.05, "maximum": 3 }, "autonomousAccelerationViewportPerSecondSquared": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 8 } } },
    "handoff": { "type": "object", "additionalProperties": false, "required": ["triggerPastMottoVh", "velocityBlendSeconds", "reverseDeadbandPx"], "properties": { "triggerPastMottoVh": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 25 }, "velocityBlendSeconds": { "$ref": "#/$defs/decimal", "minimum": 0.05, "maximum": 3 }, "reverseDeadbandPx": { "type": "integer", "minimum": 0, "maximum": 24 } } },
    "pointer": { "type": "object", "additionalProperties": false, "required": ["radiusVw", "smoothingSeconds"], "properties": { "radiusVw": { "$ref": "#/$defs/decimal", "minimum": 4, "maximum": 50 }, "smoothingSeconds": { "$ref": "#/$defs/decimal", "minimum": 0.01, "maximum": 1.5 } } },
    "motto": { "type": "object", "additionalProperties": false, "required": ["travelViewportHeights", "cardMaxWidthRem", "finalRightInsetVw", "mobileFinalLeftInsetRem", "mobileFinalRightInsetRem", "finalCenterViewportY", "orbit", "projection", "depthCues", "visibility"], "properties": { "travelViewportHeights": { "$ref": "#/$defs/decimal", "minimum": 0.25, "maximum": 2 }, "cardMaxWidthRem": { "$ref": "#/$defs/decimal", "minimum": 18, "maximum": 60 }, "finalRightInsetVw": { "$ref": "#/$defs/decimal", "minimum": 2, "maximum": 20 }, "mobileFinalLeftInsetRem": { "$ref": "#/$defs/decimal", "minimum": 1, "maximum": 5 }, "mobileFinalRightInsetRem": { "$ref": "#/$defs/decimal", "minimum": 0.5, "maximum": 3 }, "finalCenterViewportY": { "$ref": "#/$defs/decimal", "minimum": 0.2, "maximum": 0.8 }, "orbit": { "$ref": "#/$defs/mottoOrbit" }, "projection": { "$ref": "#/$defs/mottoProjection" }, "depthCues": { "$ref": "#/$defs/mottoDepthCues" }, "visibility": { "$ref": "#/$defs/mottoVisibility" } } },
    "mottoOrbit": { "type": "object", "additionalProperties": false, "required": ["thetaXDegrees", "thetaYDegrees", "phiStartDegrees", "phiPeakDegrees", "phiEndDegrees", "originDriftRadiusRatio", "localOffsetRadiusRatio"], "properties": { "thetaXDegrees": { "$ref": "#/$defs/decimal", "minimum": -75, "maximum": 75 }, "thetaYDegrees": { "$ref": "#/$defs/decimal", "minimum": -75, "maximum": 75 }, "phiStartDegrees": { "$ref": "#/$defs/decimal", "minimum": -720, "maximum": 720 }, "phiPeakDegrees": { "$ref": "#/$defs/decimal", "minimum": -720, "maximum": 720 }, "phiEndDegrees": { "$ref": "#/$defs/decimal", "minimum": -720, "maximum": 720 }, "originDriftRadiusRatio": { "type": "number", "minimum": 0, "maximum": 2 }, "localOffsetRadiusRatio": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 } } },
    "mottoProjection": { "type": "object", "additionalProperties": false, "required": ["startCenterXViewportRatio", "preferredBulge", "minimumLeftGutterPx", "minimumLeftGutterVw", "blurSafetyMultiplier", "sampleCount"], "properties": { "startCenterXViewportRatio": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "preferredBulge": { "$ref": "#/$defs/decimal", "minimum": -2, "maximum": 2 }, "minimumLeftGutterPx": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 96 }, "minimumLeftGutterVw": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 10 }, "blurSafetyMultiplier": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 4 }, "sampleCount": { "type": "integer", "minimum": 16, "maximum": 256 } } },
    "mottoDepthCues": { "type": "object", "additionalProperties": false, "required": ["scaleStart", "scaleAtPhiPeak", "scaleEnd", "blurStart", "blurAtPhiPeak", "blurEnd", "blurMaximumPx"], "properties": { "scaleStart": { "$ref": "#/$defs/decimal", "minimum": 0.05, "maximum": 2 }, "scaleAtPhiPeak": { "$ref": "#/$defs/decimal", "minimum": 0.05, "maximum": 2 }, "scaleEnd": { "$ref": "#/$defs/decimal", "minimum": 0.05, "maximum": 2 }, "blurStart": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "blurAtPhiPeak": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "blurEnd": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "blurMaximumPx": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 40 } } },
    "mottoVisibility": { "type": "object", "additionalProperties": false, "required": ["phiStartDegrees", "phiEndDegrees", "opacityStart", "opacityEnd"], "properties": { "phiStartDegrees": { "$ref": "#/$defs/decimal", "minimum": -720, "maximum": 720 }, "phiEndDegrees": { "$ref": "#/$defs/decimal", "minimum": -720, "maximum": 720 }, "opacityStart": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 }, "opacityEnd": { "$ref": "#/$defs/decimal", "minimum": 0, "maximum": 1 } } },
    "performance": { "type": "object", "additionalProperties": false, "required": ["maximumDpr", "maximumRenderDimensionPx"], "properties": { "maximumDpr": { "$ref": "#/$defs/decimal", "minimum": 1, "maximum": 1.5 }, "maximumRenderDimensionPx": { "type": "integer", "minimum": 512, "maximum": 1600 } } }
  }
}
